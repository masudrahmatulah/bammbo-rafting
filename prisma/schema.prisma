// Sumber skema — sinkron dengan docs/07_DATA_MODEL.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  wisatawan
  mitra_jasa
  mitra_penginapan
  admin
}

enum StatusVerifikasi {
  PENDING
  AKTIF
  REJECTED
}

enum JenisProdukJasa {
  rafting
  river_tubing
}

enum StatusBooking {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum StatusPembayaran {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum StatusBagiHasil {
  PENDING
  SIAP_CAIR
  CAIR
  VOID
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(wisatawan)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mitraJasa       MitraJasa?
  mitraPenginapan MitraPenginapan?
  bookings        Booking[]

  @@map("users")
}

model MitraJasa {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @unique @map("user_id") @db.Uuid
  namaUsaha            String           @map("nama_usaha") @db.VarChar(150)
  noKtpNib             String           @map("no_ktp_nib") @db.VarChar(30)
  noRekening           String           @map("no_rekening") @db.VarChar(255)
  persentaseBagiHasil  Decimal          @default(85.00) @map("persentase_bagi_hasil") @db.Decimal(5, 2)
  statusVerifikasi     StatusVerifikasi @default(PENDING) @map("status_verifikasi")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id])
  produkJasa ProdukJasa[]

  @@map("mitra_jasa")
}

model MitraPenginapan {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String           @unique @map("user_id") @db.Uuid
  namaUsaha           String           @map("nama_usaha") @db.VarChar(150)
  noKtpNib            String           @map("no_ktp_nib") @db.VarChar(30)
  noRekening          String           @map("no_rekening") @db.VarChar(255)
  persentaseBagiHasil Decimal          @default(85.00) @map("persentase_bagi_hasil") @db.Decimal(5, 2)
  statusVerifikasi    StatusVerifikasi @default(PENDING) @map("status_verifikasi")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user            User              @relation(fields: [userId], references: [id])
  kamarPenginapan KamarPenginapan[]

  @@map("mitra_penginapan")
}

model ProdukJasa {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mitraJasaId       String          @map("mitra_jasa_id") @db.Uuid
  nama              String          @db.VarChar(150)
  jenis             JenisProdukJasa
  hargaPerOrang     Decimal         @map("harga_per_orang") @db.Decimal(12, 2)
  kapasitasPerHari  Int             @map("kapasitas_per_hari")
  aktif             Boolean         @default(true)

  mitraJasa    MitraJasa      @relation(fields: [mitraJasaId], references: [id])
  bookingItems BookingItem[]

  @@map("produk_jasa")
}

model KamarPenginapan {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mitraPenginapanId   String  @map("mitra_penginapan_id") @db.Uuid
  namaKamar           String  @map("nama_kamar") @db.VarChar(150)
  hargaPerMalam       Decimal @map("harga_per_malam") @db.Decimal(12, 2)
  kapasitasKamar      Int     @map("kapasitas_kamar")
  jumlahUnit          Int     @default(1) @map("jumlah_unit")
  aktif               Boolean @default(true)

  mitraPenginapan MitraPenginapan @relation(fields: [mitraPenginapanId], references: [id])
  bookingItems    BookingItem[]

  @@map("kamar_penginapan")
}

model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  kodeBooking    String        @unique @map("kode_booking") @db.VarChar(20)
  tanggalMulai   DateTime      @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime      @map("tanggal_selesai") @db.Date
  status         StatusBooking @default(PENDING)
  totalHarga     Decimal       @map("total_harga") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user        User          @relation(fields: [userId], references: [id])
  items       BookingItem[]
  pembayaran  Pembayaran?

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String  @map("booking_id") @db.Uuid
  produkJasaId        String? @map("produk_jasa_id") @db.Uuid
  kamarPenginapanId   String? @map("kamar_penginapan_id") @db.Uuid
  jumlah              Int
  subtotal            Decimal @db.Decimal(12, 2)

  booking         Booking          @relation(fields: [bookingId], references: [id])
  produkJasa      ProdukJasa?      @relation(fields: [produkJasaId], references: [id])
  kamarPenginapan KamarPenginapan? @relation(fields: [kamarPenginapanId], references: [id])
  bagiHasil       BagiHasil?

  @@index([produkJasaId, bookingId])
  @@index([kamarPenginapanId, bookingId])
  @@map("booking_items")
}

model Pembayaran {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String           @unique @map("booking_id") @db.Uuid
  midtransOrderId  String           @unique @map("midtrans_order_id") @db.VarChar(60)
  metode           String?          @db.VarChar(30)
  status           StatusPembayaran @default(PENDING)
  jumlah           Decimal          @db.Decimal(12, 2)
  paidAt           DateTime?        @map("paid_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("pembayaran")
}

model BagiHasil {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingItemId   String          @unique @map("booking_item_id") @db.Uuid
  porsiPlatform   Decimal         @map("porsi_platform") @db.Decimal(12, 2)
  porsiMitra      Decimal         @map("porsi_mitra") @db.Decimal(12, 2)
  status          StatusBagiHasil @default(PENDING)
  dicairkanAt     DateTime?       @map("dicairkan_at") @db.Timestamptz

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id])

  @@index([status])
  @@map("bagi_hasil")
}

model Ulasan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingItemId String   @unique @map("booking_item_id") @db.Uuid
  rating        Int      @db.SmallInt
  komentar      String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("ulasan")
}
